# basic configuration
PROJECT_NAME = %LIB_NAME%
PROJECT_LOGO = ../../../images/ALL_logo.jpg
INPUT = ./_%LAN%_v%VER%_docstrings/
FILE_PATTERNS = %PATTERNS%
RECURSIVE = YES
OUTPUT_DIRECTORY = ./build_sub/

# parsing configuration
EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
HIDE_UNDOC_MEMBERS = NO
# Off on purpose: INPUT is the generated mirror, not the real build context, so clang only
# reported missing Conan headers that the docs job never installs.
CLANG_ASSISTED_PARSING = NO
# Show include/ src/ dox/ rather than the mirror's internal folder name.
FULL_PATH_NAMES = YES
STRIP_FROM_PATH = ./_%LAN%_v%VER%_docstrings
STRIP_FROM_INC_PATH = ./_%LAN%_v%VER%_docstrings

# export format
GENERATE_HTML = YES
GENERATE_LATEX = NO

# internationalization configuration
OUTPUT_LANGUAGE = %FULL_LAN%

# customized configuration
ALIASES += "exporter="
ALIASES += "attacher="

# Graphviz support
HAVE_DOT = YES
DOT_PATH = %GRAPHVIZ_BIN%
DOT_IMAGE_FORMAT = svg
CALL_GRAPH = YES
USE_MATHJAX = YES

# image configuration
IMAGE_PATH = ../../../images

# customized configuration
ALIASES += "exporter="
ALIASES += "attacher="

# support examples source
EXAMPLE_PATH = %EXAMPLE_DIRS%
EXAMPLE_PATTERNS = *.cxx
EXAMPLE_RECURSIVE = YES