{
  "name": "het-devtools",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.4.0",
  "publisher": "het-fti",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CubicZebra/HeT-DevTools.git"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "cpp",
    "c",
    "conan",
    "cmake",
    "fcpp",
    "het",
    "library",
    "build",
    "test",
    "documentation",
    "benchmark"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f24",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/metadata.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "HeT DevTools",
      "properties": {
        "het.conan.profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.conanProfiles%"
        },
        "het.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.telemetryEnabled%"
        },
        "het.template.localPath": {
          "type": "string",
          "default": "",
          "description": "Local fcpp template directory for offline project init (falls back to HET_TEMPLATE_LOCAL, then workspace/fcpp when present)."
        },
        "het.tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Manual toolchain overrides: het.tools.<name> = absolute executable path (e.g. conan, cmake, doxygen, graphviz/dot, clang-format). Set from the dashboard '环境与工具链' block."
        },
        "het.env.pipIndexUrl": {
          "type": "string",
          "default": "",
          "description": "%config.envPipIndexUrl%"
        },
        "het.env.conanRemote": {
          "type": "string",
          "default": "",
          "description": "%config.envConanRemote%"
        },
        "het.env.wslRootfsUrl": {
          "type": "string",
          "default": "",
          "description": "%config.envWslRootfsUrl%"
        },
        "het.env.wslRootfsSha256": {
          "type": "string",
          "default": "",
          "description": "%config.envWslRootfsSha256%"
        },
        "het.env.keepRootfsCache": {
          "type": "boolean",
          "default": false,
          "description": "%config.envKeepRootfsCache%"
        },
        "het.env.httpProxy": {
          "type": "string",
          "default": "",
          "description": "%config.envHttpProxy%"
        }
      }
    },
    "commands": [
      {
        "command": "het.hello",
        "title": "HeT DevTools: Hello (smoke test)"
      },
      {
        "command": "het.refresh",
        "title": "%cmd.refresh%"
      },
      {
        "command": "het.build",
        "title": "%cmd.build%"
      },
      {
        "command": "het.dashboard",
        "title": "%cmd.dashboard%"
      },
      {
        "command": "het.healthCheck",
        "title": "%cmd.healthCheck%"
      },
      {
        "command": "het.test",
        "title": "%cmd.test%"
      },
      {
        "command": "het.showTestResults",
        "title": "%cmd.showTestResults%"
      },
      {
        "command": "het.openSettings",
        "title": "%cmd.openSettings%"
      },
      {
        "command": "het.openDeps",
        "title": "%cmd.openDeps%"
      },
      {
        "command": "het.addDependency",
        "title": "%cmd.addDependency%"
      },
      {
        "command": "het.refreshConanIndex",
        "title": "%cmd.refreshConanIndex%"
      },
      {
        "command": "het.newModule",
        "title": "%cmd.newModule%"
      },
      {
        "command": "het.generateTests",
        "title": "%cmd.generateTests%"
      },
      {
        "command": "het.refreshTests",
        "title": "%cmd.refreshTests%"
      },
      {
        "command": "het.coverage",
        "title": "%cmd.coverage%"
      },
      {
        "command": "het.docs",
        "title": "%cmd.docs%"
      },
      {
        "command": "het.quality",
        "title": "%cmd.quality%"
      },
      {
        "command": "het.commit",
        "title": "%cmd.commit%"
      },
      {
        "command": "het.commitRelease",
        "title": "%cmd.commitRelease%"
      },
      {
        "command": "het.release",
        "title": "%cmd.release%"
      },
      {
        "command": "het.preflight",
        "title": "%cmd.preflight%"
      },
      {
        "command": "het.benchmark",
        "title": "%cmd.benchmark%"
      },
      {
        "command": "het.ci",
        "title": "%cmd.ci%"
      },
      {
        "command": "het.audit",
        "title": "%cmd.audit%"
      },
      {
        "command": "het.patent",
        "title": "%cmd.patent%"
      },
      {
        "command": "het.newProject",
        "title": "%cmd.newProject%"
      },
      {
        "command": "het.newProjectHere",
        "title": "%cmd.newProjectHere%"
      },
      {
        "command": "het.chipOverview",
        "title": "%cmd.chipOverview%"
      },
      {
        "command": "het.templateUpdate",
        "title": "%cmd.templateUpdate%"
      },
      {
        "command": "het.cockpit",
        "title": "%cmd.cockpit%"
      },
      {
        "command": "het.envCheck",
        "title": "%cmd.envCheck%"
      },
      {
        "command": "het.envDump",
        "title": "%cmd.envDump%"
      },
      {
        "command": "het.envStatus",
        "title": "%cmd.envStatus%"
      },
      {
        "command": "het.envPrepare",
        "title": "%cmd.envPrepare%"
      },
      {
        "command": "het.envRemove",
        "title": "%cmd.envRemove%"
      },
      {
        "command": "het.useSystemToolchain",
        "title": "%cmd.useSystemToolchain%"
      },
      {
        "command": "het.getHostCapabilities",
        "title": "%cmd.getHostCapabilities%"
      },
      {
        "command": "het.getProvisionPlan",
        "title": "%cmd.getProvisionPlan%"
      },
      {
        "command": "het.getWslLane",
        "title": "%cmd.getWslLane%"
      },
      {
        "command": "het.getLinuxLane",
        "title": "%cmd.getLinuxLane%"
      },
      {
        "command": "het.getMacosLane",
        "title": "%cmd.getMacosLane%"
      },
      {
        "command": "het.openDocsArtifact",
        "title": "%cmd.openDocsArtifact%"
      },
      {
        "command": "het.openBuildOutput",
        "title": "%cmd.openBuildOutput%"
      },
      {
        "command": "het.openCoverageReport",
        "title": "%cmd.openCoverageReport%"
      },
      {
        "command": "het.healthReport",
        "title": "%cmd.healthReport%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "het.newProjectHere",
          "when": "explorerResourceIsFolder",
          "group": "het@1"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "het.assistant",
        "name": "het",
        "description": "HeT DevTools intent router: natural language → matching HeT GUI action",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "compile:tests": "node esbuild.mjs --tests",
    "compile:integration": "node esbuild.mjs --integration",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run compile && npm run compile:tests && mocha \"out/test/**/*.test.js\"",
    "test:integration": "npm run compile && npm run compile:integration && node scripts/run-integration.mjs",
    "test:c1": "npm run compile && node esbuild.mjs --c1 && node scripts/run-c1.mjs",
    "test:c2": "npm run compile && node esbuild.mjs --c2 && node scripts/run-c2.mjs",
    "test:c3": "npm run compile && node esbuild.mjs --c3 && node scripts/run-c3.mjs",
    "test:c4": "npm run compile && node esbuild.mjs --c4 && node scripts/run-c4.mjs",
    "package": "npm run asset && vsce package --no-dependencies",
    "test:c5": "npm run compile && node esbuild.mjs --c5 && node scripts/run-c5.mjs",
    "test:c6": "npm run compile && node esbuild.mjs --c6 && node scripts/run-c6.mjs",
    "test:c7": "npm run compile && node esbuild.mjs --c7 && node scripts/run-c7.mjs",
    "asset": "node scripts/build-template-asset.mjs",
    "test:real": "npm run compile && node esbuild.mjs --real && node scripts/run-real.mjs",
    "audit:pins": "npm run compile && npm run compile:tests && mocha out/test/auditPins.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.134.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "mocha": "^10.8.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
